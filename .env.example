# Backend only. Copy to .env; never commit a real key.
DASHSCOPE_API_KEY=
# Copy the OpenAI-compatible base URL and qwen3-rerank URL from the SAME regional console.
# Workspace example: https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# Workspace example: https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
DASHSCOPE_RERANK_URL=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_RERANK_MODEL=qwen3-rerank
GENERATION_MODEL=qwen-plus

# Optional Full Mode assets; API Demo needs no classifier weights.
LEGALMIND_BASE_MODEL=Qwen/Qwen3-4B
LEGALMIND_ADAPTER=artifacts/models/classifier/checkpoint-7500
LEGALMIND_LABEL_MAPPING=artifacts/models/classifier/label_mapping.json
LEGALMIND_THRESHOLDS=artifacts/models/classifier/thresholds.json
LEGALMIND_HYBRID_INDEX=artifacts/indexes/cail2018-v2_1_1
LEGALMIND_STATUTE_INDEX=artifacts/indexes/statutes_bm25_temporal_v3
